<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRootLayout"
    android:background="@drawable/bg_cyber_space"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miHoYo.GenshinImpact.utils.BelieveBackgroundView
        android:id="@+id/believeBgView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ScrollView
        android:id="@+id/scrollContent"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="36dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/topBrandingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:background="@drawable/bg_cyber_logo_frame"
                    android:padding="2dp"
                    android:layout_width="76dp"
                    android:layout_height="76dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/logo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_exora_logo"
                        android:scaleType="centerCrop"
                        android:adjustViewBounds="true"
                        android:contentDescription="EXORA LOADER Logo"
                        app:shapeAppearanceOverlay="@style/Theme.CheatUIDev.ShapeAppearanceOverlay.Circle"/>
                </RelativeLayout>
                <TextView
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="EXORA"
                    android:shadowColor="#8000f0ff"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="14"
                    android:fontFamily="@font/roboto"
                    android:letterSpacing="0.28"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp">
                    <View
                        android:background="@color/cyber_cyan_accent"
                        android:layout_width="45dp"
                        android:layout_height="1.5dp"/>
                    <TextView
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/cyber_cyan_accent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"
                        android:text="LOADER"
                        android:fontFamily="@font/roboto"
                        android:letterSpacing="0.32"
                        android:layout_marginHorizontal="12dp"/>
                    <View
                        android:background="@color/cyber_cyan_accent"
                        android:layout_width="45dp"
                        android:layout_height="1.5dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/cyber_cyan_muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="NEXT LEVEL GAMING EXPERIENCE"
                    android:fontFamily="@font/roboto"
                    android:letterSpacing="0.18"/>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/loginCardBox"
                    android:background="@drawable/bg_cyber_card_neon"
                    android:paddingLeft="18dp"
                    android:paddingTop="22dp"
                    android:paddingRight="18dp"
                    android:paddingBottom="22dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="18dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PASSWORD KEY LOGIN"
                        android:fontFamily="@font/roboto"
                        android:letterSpacing="0.08"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/inputContainer"
                        android:background="@drawable/bg_cyber_input_pill"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="20dp"
                        android:paddingHorizontal="14dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_cyber_key"
                            android:scaleType="fitCenter"
                            android:contentDescription="Key Icon"/>
                        <EditText
                            android:textSize="14sp"
                            android:textColor="@color/white"
                            android:textColorHint="@color/cyber_input_hint"
                            android:id="@+id/email_field"
                            android:background="@null"
                            android:padding="0dp"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:hint="••••••••••••"
                            android:singleLine="true"
                            android:layout_weight="1"
                            android:inputType="textPassword"
                            android:fontFamily="@font/roboto"
                            android:layout_marginStart="10dp"
                            android:letterSpacing="0.05"/>
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:id="@+id/btnToggleVisibility"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:focusable="true"
                                android:clickable="true"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_cyber_eye"
                                android:scaleType="fitCenter"
                                android:contentDescription="Toggle Visibility"/>
                            <ImageView
                                android:id="@+id/btnPasteKey"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:focusable="true"
                                android:clickable="true"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_cyber_clipboard"
                                android:scaleType="fitCenter"
                                android:contentDescription="Paste Key"
                                android:layout_marginStart="12dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp">
                        <View
                            android:background="@color/cyber_card_border_dim"
                            android:layout_width="match_parent"
                            android:layout_height="0.8dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/btnLogin"
                        android:background="@drawable/bg_cyber_btn_login"
                        android:paddingLeft="24dp"
                        android:paddingTop="10dp"
                        android:paddingRight="24dp"
                        android:paddingBottom="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginRight="8dp"
                        android:layout_marginHorizontal="8dp"
                        android:paddingHorizontal="24dp"
                        android:paddingVertical="10dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_cyber_lock"
                            android:scaleType="fitCenter"
                            android:contentDescription="Lock"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOGIN"
                            android:fontFamily="@font/roboto"
                            android:layout_marginStart="10dp"
                            android:letterSpacing="0.12"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/cyber_cyan_accent"
                        android:id="@+id/btnGetKey"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Get Key"
                        android:fontFamily="@font/roboto"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:id="@+id/btnGoogle"
                        android:background="@drawable/bg_cyber_btn_login"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_google"
                            android:contentDescription="Google logo"/>
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Login with Google"
                            android:fontFamily="@font/roboto"
                            android:layout_marginStart="10dp"/>
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="8dp"
                        android:progressTint="@color/cyber_cyan_accent"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/cyber_cyan_bright"
                        android:id="@+id/tvStatus"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/roboto"/>
                    <TextView
                        android:textSize="11.5sp"
                        android:textColor="@color/cyber_cyan_muted"
                        android:id="@+id/tvSubtitle"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto"/>
                </LinearLayout>
                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="146dp"
                    android:src="@drawable/ic_cyber_triangle_left"
                    android:contentDescription="Accent"
                    android:layout_alignParentStart="true"/>
                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="146dp"
                    android:src="@drawable/ic_cyber_triangle_right"
                    android:contentDescription="Accent"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_cyber_shield"
                    android:scaleType="fitCenter"
                    android:contentDescription="Security Shield"/>
                <TextView
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/cyber_cyan_subtle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SECURE &amp; ENCRYPTED CONNECTION"
                    android:fontFamily="@font/roboto"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.12"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:minHeight="36dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/boxAntiBan"
                    android:background="@drawable/bg_cyber_info_box"
                    android:paddingLeft="12dp"
                    android:paddingTop="10dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_cyber_shield"
                        android:scaleType="fitCenter"
                        android:contentDescription="Shield"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/cyber_cyan_accent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100% SAFE"
                            android:fontFamily="@font/roboto"
                            android:letterSpacing="0.04"/>
                        <TextView
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:textColor="@color/cyber_cyan_muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="ANTI BAN SYSTEM"
                            android:fontFamily="@font/roboto"
                            android:letterSpacing="0.06"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/boxSupport"
                    android:background="@drawable/bg_cyber_info_box"
                    android:paddingLeft="12dp"
                    android:paddingTop="10dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="10dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_cyber_headphone"
                        android:scaleType="fitCenter"
                        android:contentDescription="Headphones"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/cyber_cyan_accent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SUPPORT"
                            android:fontFamily="@font/roboto"
                            android:letterSpacing="0.04"/>
                        <TextView
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:textColor="@color/cyber_cyan_muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="24/7 ONLINE"
                            android:fontFamily="@font/roboto"
                            android:letterSpacing="0.06"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <View
                android:id="@+id/btnTelegram"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <View
                android:id="@+id/blurBottomPanel"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <View
                android:id="@+id/bottomPanel"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/footerSection"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:id="@+id/tvCopyright"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copyright @2025 - EXORA LOADER"/>
                <TextView
                    android:id="@+id/tvLoaderId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loader"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

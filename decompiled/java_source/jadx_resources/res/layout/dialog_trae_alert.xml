<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/dialogBlurView"
    android:background="@drawable/bg_believe_modal_loading"
    android:layout_width="295dp"
    android:layout_height="wrap_content"
    app:blurOverlayColor="#00000000">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="28dp"
        android:paddingRight="24dp"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="28dp">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/dialogAlertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notice"
            android:fontFamily="@font/roboto"/>
        <TextView
            android:textSize="13.5sp"
            android:textColor="@color/cyber_cyan_muted"
            android:gravity="center"
            android:id="@+id/dialogAlertMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Message details"
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/roboto"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/btnAlertPositive"
            android:background="@drawable/bg_cyber_btn_login"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:text="OK"
            android:textAllCaps="true"
            android:fontFamily="@font/roboto"
            android:letterSpacing="0.04"/>
    </LinearLayout>
</eightbitlab.com.blurview.BlurView>

<?xml version="1.0" encoding="utf-8"?>
<eightbitlab.com.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/dialogBlurView"
    android:background="@drawable/bg_believe_modal_loading"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    app:blurOverlayColor="#00000000">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingTop="28dp"
        android:paddingRight="24dp"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="28dp">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginBottom="14dp"
            android:src="@drawable/ic_exora_logo"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="Exora Logo"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="24dp">
            <View
                android:id="@+id/dot1"
                android:background="@drawable/circle_exora_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:translationY="2dp"
                android:layout_marginEnd="8dp"/>
            <View
                android:id="@+id/dot2"
                android:background="@drawable/circle_exora_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:translationY="-3dp"/>
            <View
                android:id="@+id/dot3"
                android:background="@drawable/circle_exora_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:translationY="2dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Verifying..."
            android:fontFamily="@font/roboto"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/cyber_cyan_muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Please wait, verifying owner key"
            android:fontFamily="@font/roboto"/>
    </LinearLayout>
</eightbitlab.com.blurview.BlurView>

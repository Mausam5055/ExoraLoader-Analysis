<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRootLayout"
    android:background="@drawable/bg_cyber_space"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.miHoYo.GenshinImpact.utils.BelieveBackgroundView
        android:id="@+id/believeBgView"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ScrollView
        android:id="@+id/scrollContent"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="4dp"
            android:paddingRight="12dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp">
            <RelativeLayout
                android:id="@+id/topHeaderBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true">
                    <RelativeLayout
                        android:background="@drawable/bg_cyber_logo_frame"
                        android:padding="1.5dp"
                        android:layout_width="38dp"
                        android:layout_height="38dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/appLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ic_exora_logo"
                            android:scaleType="centerCrop"
                            android:adjustViewBounds="true"
                            android:contentDescription="EXORA LOADER Logo"
                            app:shapeAppearanceOverlay="@style/Theme.CheatUIDev.ShapeAppearanceOverlay.Circle"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp">
                        <TextView
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EXORA LOADER"
                            android:fontFamily="@font/roboto"
                            android:letterSpacing="0.08"/>
                        <TextView
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/cyber_cyan_accent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="NEXT LEVEL GAMING • VIP"
                            android:fontFamily="@font/roboto"
                            android:letterSpacing="0.12"/>
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/btnNotification"
                    android:background="@drawable/bg_cyber_circle_container"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_bell_outline"
                        android:scaleType="fitCenter"
                        android:layout_centerInParent="true"
                        android:contentDescription="Notification Bell"
                        app:tint="@color/cyber_cyan_accent"/>
                    <View
                        android:background="@drawable/circle_red_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginTop="8dp"
                        android:layout_alignParentTop="true"
                        android:layout_marginEnd="8dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </RelativeLayout>
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardDevice"
                android:background="@drawable/bg_cyber_card_subtle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingTop="12dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">
                    <RelativeLayout
                        android:background="@drawable/bg_cyber_circle_container"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_device_phone"
                            android:scaleType="fitCenter"
                            android:layout_centerInParent="true"
                            android:contentDescription="Phone Icon"
                            app:tint="@color/cyber_cyan_accent"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:id="@+id/tvDeviceModel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="vivo I2405 (I2405)"
                            android:fontFamily="@font/roboto"/>
                        <TextView
                            android:textSize="11.5sp"
                            android:textColor="@color/cyber_cyan_muted"
                            android:id="@+id/tvDeviceAndroid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Android 15 · Arm64-v8a"
                            android:fontFamily="@font/roboto"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_cyber_badge_active"
                        android:paddingLeft="12dp"
                        android:paddingTop="6dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">
                        <View
                            android:background="@drawable/circle_green_dot"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginEnd="6dp"/>
                        <TextView
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/cyber_badge_green"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Connected"
                            android:fontFamily="@font/roboto"/>
                    </LinearLayout>
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardSubscription"
                android:background="@drawable/bg_cyber_card_neon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RelativeLayout
                            android:background="@drawable/bg_cyber_circle_container"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_cyber_crown"
                                android:scaleType="fitCenter"
                                android:layout_centerInParent="true"
                                android:contentDescription="Crown"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VIP LICENSE KEY"
                                android:fontFamily="@font/roboto"
                                android:letterSpacing="0.06"/>
                            <TextView
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyber_cyan_accent"
                                android:id="@+id/tvLicenseKey"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="KEY : ••••••"
                                android:fontFamily="@font/roboto"
                                android:letterSpacing="0.04"/>
                        </LinearLayout>
                        <TextView
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/cyber_badge_green"
                            android:background="@drawable/bg_cyber_badge_active"
                            android:paddingLeft="10dp"
                            android:paddingTop="5dp"
                            android:paddingRight="10dp"
                            android:paddingBottom="5dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● VIP ACTIVE"
                            android:fontFamily="@font/roboto"
                            android:letterSpacing="0.08"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="5dp"/>
                    </LinearLayout>
                    <View
                        android:background="@color/cyber_card_border_dim"
                        android:layout_width="match_parent"
                        android:layout_height="0.8dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/cyber_cyan_muted"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⏱  LICENSE VALIDITY COUNTDOWN"
                        android:fontFamily="@font/roboto"
                        android:letterSpacing="0.1"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_cyber_countdown_box"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:paddingVertical="10dp">
                            <TextView
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyber_cyan_neon"
                                android:id="@+id/tvDays"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="8.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyber_cyan_muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="DAYS"
                                android:fontFamily="@font/roboto"
                                android:letterSpacing="0.08"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_cyber_countdown_box"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2dp"
                            android:layout_marginRight="2dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="2dp"
                            android:paddingVertical="10dp">
                            <TextView
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyber_cyan_neon"
                                android:id="@+id/tvHours"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="8.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyber_cyan_muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="HOURS"
                                android:fontFamily="@font/roboto"
                                android:letterSpacing="0.08"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_cyber_countdown_box"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="2dp"
                            android:layout_marginRight="2dp"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="2dp"
                            android:paddingVertical="10dp">
                            <TextView
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyber_cyan_neon"
                                android:id="@+id/tvMins"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="8.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyber_cyan_muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="MINUTES"
                                android:fontFamily="@font/roboto"
                                android:letterSpacing="0.08"/>
                        </LinearLayout>
                        <LinearLayout
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/bg_cyber_countdown_box"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:paddingVertical="10dp">
                            <TextView
                                android:textSize="19sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyber_cyan_neon"
                                android:id="@+id/tvSecs"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="8.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyber_cyan_muted"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="SECONDS"
                                android:fontFamily="@font/roboto"
                                android:letterSpacing="0.08"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardGame"
                android:background="@drawable/bg_cyber_card_neon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:src="@drawable/india"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/Theme.CheatUIDev.ShapeAppearanceOverlay.Circle"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp">
                            <TextView
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:id="@+id/gameTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Battlegrounds India"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="11.5sp"
                                android:textColor="@color/cyber_cyan_muted"
                                android:id="@+id/gamePackage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Package : com.pubg.imobile"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="11.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/cyber_cyan_bright"
                                android:id="@+id/gameVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Version : 4.6.0"
                                android:fontFamily="@font/roboto"/>
                            <TextView
                                android:textSize="11.5sp"
                                android:textColor="@color/cyber_cyan_subtle"
                                android:id="@+id/gameSupported"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Supported : 4.6.0"
                                android:fontFamily="@font/roboto"/>
                        </LinearLayout>
                        <View
                            android:id="@+id/btnGameMenu"
                            android:visibility="gone"
                            android:layout_width="0dp"
                            android:layout_height="0dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/progressCard"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">
                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:max="100"
                            android:indeterminate="false"
                            android:progressTint="@color/cyber_cyan_accent"
                            style="?android:attr/progressBarStyleHorizontal"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/cyber_cyan_muted"
                            android:id="@+id/progressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Preparing OBB..."
                            android:fontFamily="@font/roboto"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:id="@+id/btnLaunchGame"
                        android:background="@drawable/bg_cyber_btn_launch"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:elevation="6dp"
                        android:paddingHorizontal="20dp">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_m3_rocket"
                                android:scaleType="fitCenter"
                                android:contentDescription="Rocket"
                                android:layout_marginEnd="8dp"/>
                            <TextView
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LAUNCH GAME"
                                android:fontFamily="@font/roboto"
                                android:letterSpacing="0.12"/>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_arrow_forward_white"
                            android:scaleType="fitCenter"
                            android:layout_centerVertical="true"
                            android:contentDescription="Launch Arrow"
                            android:layout_alignParentEnd="true"/>
                    </RelativeLayout>
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardHideEsp"
                android:background="@drawable/bg_cyber_card_subtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingTop="12dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">
                    <RelativeLayout
                        android:background="@drawable/bg_cyber_circle_container"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_eye_slash"
                            android:scaleType="fitCenter"
                            android:layout_centerInParent="true"
                            android:contentDescription="Hide ESP"
                            app:tint="@color/cyber_cyan_accent"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="��  Hide ESP (Stream Safe)"
                            android:fontFamily="@font/roboto"/>
                        <TextView
                            android:textSize="11.5sp"
                            android:textColor="@color/cyber_cyan_muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Anti-Record &amp; Screenshot Safe"
                            android:fontFamily="@font/roboto"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchHideEsp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/bg_switch_thumb_modern"
                        app:track="@drawable/bg_switch_track_modern"/>
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>
            <View
                android:layout_width="match_parent"
                android:layout_height="32dp"/>
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/cardSdkActivated"
                android:background="@drawable/bg_cyber_card_subtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="14dp"
                    android:paddingTop="12dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">
                    <RelativeLayout
                        android:background="@drawable/bg_cyber_circle_container"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_cyber_shield"
                            android:scaleType="fitCenter"
                            android:layout_centerInParent="true"
                            android:contentDescription="Shield"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/cyber_cyan_accent"
                            android:id="@+id/tvSdkTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SDK ACTIVATED"
                            android:fontFamily="@font/roboto"
